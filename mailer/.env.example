# ---------------------------------------------------------------------------
# Gmail mail-merge dashboard - environment configuration
# Copy this file to `.env` (same folder) and fill in your values.
# NEVER commit the real .env file - it holds your Google OAuth client secret.
# ---------------------------------------------------------------------------

# OAuth 2.0 client (type: "Desktop app") from Google Cloud Console
# https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Dashboard binding. Keep 127.0.0.1 unless you know what you are doing -
# the dashboard stores Gmail refresh tokens and must not be exposed.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8200

# Must match the redirect URI whitelisted in Google Cloud (loopback only)
OAUTH_REDIRECT_URI=http://127.0.0.1:8200/oauth2/callback

# Sending policy (conservative defaults - respect them)
# Seconds to wait between two e-mails (jitter is added automatically)
DEFAULT_RATE_DELAY_SEC=8
# Per-account cap the dashboard enforces on itself (Gmail's own limit is 500/day
# for regular accounts, 2000/day for Google Workspace)
DEFAULT_ACCOUNT_DAILY_LIMIT=150
# Per-campaign cap per day
DEFAULT_CAMPAIGN_DAILY_MAX=60
# Retries for temporary (5xx / network) errors before a message is marked failed
MAX_SEND_ATTEMPTS=4
# Pause the campaign after this many consecutive rejections
MAX_CONSECUTIVE_PERMANENT_FAILURES=5
