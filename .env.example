# =============================================================================
#  INNODEVORA — ENVIRONMENT CONFIGURATION
#  Copy this file to .env and edit it locally. Never commit .env.
# =============================================================================

# --- Demo trust experience (testimonials + Trustpilot-style preview) ---------
# true  -> show the fictional review sections when the site is built/served
# false -> never show them
#
# The static site also treats localhost as an automatic preview host. On any
# non-local host the default is OFF, and innodevora.com is blocked even if this
# value is accidentally left on. See DEMO-TRUST.md for the full precedence.
VITE_SHOW_DEMO_TRUST=true

# --- Server ------------------------------------------------------------------
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Public origin used for documentation and absolute links. The API always
# enforces same-origin requests from the actual incoming Host header.
SITE_ORIGIN=http://localhost:3000
# Set to true only when the app is behind a trusted reverse proxy that sets
# X-Forwarded-For / X-Forwarded-Proto. Never trust those headers directly.
TRUST_PROXY=false

# --- Storage -----------------------------------------------------------------
# SQLite database and runtime secrets. Keep this directory on a persistent disk
# in production. It is git-ignored.
DATA_DIR=data
DATABASE_PATH=data/innodevora-chat.db
KNOWLEDGE_PATH=knowledge/INNODEVORA.md

# --- AI provider -------------------------------------------------------------
# OpenAI-compatible chat-completions endpoint. The API key is server-side only.
# Leave AI_API_KEY empty in production to disable the assistant gracefully.
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_TIMEOUT_MS=45000
AI_MAX_OUTPUT_TOKENS=700
AI_TEMPERATURE=0.3
# Development-only deterministic knowledge fallback when no provider key is set.
# In production this defaults to false. Set true only for a deliberate demo.
AI_KEYLESS_DEMO=true
AI_STREAM_DELAY_MS=18

# --- Admin authentication ----------------------------------------------------
# Create a password hash with:
#   npm run admin:hash
# Then paste the printed value into ADMIN_PASSWORD_HASH and leave
# ADMIN_PASSWORD empty. If both are empty, the admin dashboard stays disabled.
ADMIN_USERNAME=owner
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=
ADMIN_ROLE=owner
ADMIN_SESSION_HOURS=12
ADMIN_LOGIN_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_MINUTES=15
# Set true to append "; Secure" to cookies even when behind a TLS proxy.
COOKIE_SECURE=auto

# --- Visitor sessions, consent and retention ---------------------------------
VISITOR_SESSION_DAYS=30
VISITOR_RETENTION_DAYS=180
CONVERSATION_RETENTION_DAYS=365
MESSAGE_HISTORY_LIMIT=40
MAX_MESSAGE_CHARS=1500
RATE_LIMIT_PER_MINUTE=12
RATE_LIMIT_PER_HOUR=80
RATE_LIMIT_BURST=4

# --- Lead scoring (configurable, non-sensitive signals only) -----------------
LEAD_WEIGHT_PROJECT_TYPE=10
LEAD_WEIGHT_DESCRIPTION=10
LEAD_WEIGHT_BUDGET=20
LEAD_WEIGHT_TIMELINE=15
LEAD_WEIGHT_QUOTE=15
LEAD_WEIGHT_CONTACT=15
LEAD_WEIGHT_COMPANY=5
LEAD_WEIGHT_REPEAT=5
LEAD_QUALIFIED_THRESHOLD=45

# --- Security ----------------------------------------------------------------
# Optional salt for one-way IP hashing. If omitted, a random salt is generated
# under DATA_DIR and reused. Do not rotate casually if you need rate-limit history.
IP_HASH_SALT=
